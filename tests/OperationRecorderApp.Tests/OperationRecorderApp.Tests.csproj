<Project Sdk="Microsoft.NET.Sdk">

  <!-- アプリと同じサービス・フォーム・CLIを通す機能試験。入口はdev/scripts/Test-OperationRecorder.ps1。 -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OperationRecorder/OperationRecorderApp.csproj" />
    <ProjectReference Include="../OperationRecorder.EvidenceFixture/OperationRecorder.EvidenceFixture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
